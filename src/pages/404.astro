---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Bhavani Bala">
  <div class="not-found">
    <div class="code">404</div>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or may have moved.</p>
    <a href="/" class="home-link">
      Back to home
      <span class="underline"></span>
    </a>
  </div>

  <style>
    .not-found {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 12px;
      padding: 96px 48px;
      max-width: 1240px;
      margin: 0 auto;
      font-family: var(--font-mono);
      color: var(--ink);
    }

    @media (max-width: 600px) {
      .not-found {
        padding: 64px 20px;
      }
    }

    .code {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 72px;
      color: var(--accent);
      line-height: 1;
    }

    .not-found h1 {
      margin: 8px 0 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 22px;
      text-transform: uppercase;
      letter-spacing: 0.01em;
    }

    .not-found p {
      margin: 0 0 12px;
      font-size: 15px;
      color: var(--muted-strong);
    }

    .home-link {
      position: relative;
      color: var(--ink);
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
    }

    .home-link .underline {
      display: block;
      height: 2px;
      margin-top: 2px;
      background: var(--accent);
    }
  </style>
</BaseLayout>
