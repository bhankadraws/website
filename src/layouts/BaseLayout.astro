---
import '../styles/global.css';
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  active: 'work' | 'about' | 'resume';
}

const { title, active } = Astro.props;

const navItems = [
  { key: 'work', label: 'Work', href: '/' },
  { key: 'about', label: 'About', href: '/about' },
  { key: 'resume', label: 'Resume', href: '/resume' },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="nav">
      <a href="/" class="nav-logo"><Image src={logo} alt="Bhavani Bala" height={56} /></a>
      <div class="nav-links">
        {
          navItems.map((item) => (
            <a class:list={['nav-link', { active: active === item.key }]} href={item.href}>
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="nav-social">
        <a
          href="https://instagram.com/bhankadraws"
          class="nav-social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/bhavanibala/"
          class="nav-social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <line x1="7.5" y1="10" x2="7.5" y2="17" />
            <circle cx="7.5" cy="6.7" r="0.9" fill="currentColor" stroke="none" />
            <path d="M11.5 17v-4.2c0-1.7 1-2.6 2.4-2.6 1.3 0 2.1.9 2.1 2.6V17" />
            <line x1="11.5" y1="10" x2="11.5" y2="17" />
          </svg>
        </a>
        <a href="mailto:bhankadraws@gmail.com" class="nav-social-link" aria-label="Email">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M4 6.5l8 6 8-6" />
          </svg>
        </a>
      </div>
    </div>

    <slot />

    <div class="footer">&copy;2026, Bhavani Balasubramanyam.</div>

    <style>
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 26px 48px;
        border-bottom: 2px dashed var(--border-dashed);
      }

      @media (max-width: 900px) {
        .nav {
          padding: 22px 32px;
        }
      }

      @media (max-width: 600px) {
        .nav {
          flex-direction: column;
          justify-content: center;
          gap: 16px;
          padding: 18px 20px;
        }
      }

      .nav-logo {
        display: block;
        line-height: 0;
      }

      @media (max-width: 600px) {
        .nav-logo :global(img) {
          height: 40px;
          width: auto;
        }
      }

      .nav-links {
        display: flex;
        gap: 36px;
        font-family: var(--font-mono);
        font-size: 14px;
        letter-spacing: 0.02em;
      }

      @media (max-width: 600px) {
        .nav-links {
          gap: 20px;
          font-size: 13px;
        }
      }

      .nav-link {
        color: var(--ink);
        text-decoration: none;
        opacity: 0.65;
      }

      .nav-link.active {
        opacity: 1;
        text-decoration: underline;
        text-decoration-style: wavy;
        text-decoration-color: var(--accent);
        text-underline-offset: 4px;
      }

      .nav-social {
        display: flex;
        align-items: center;
        gap: 18px;
        color: var(--accent);
      }

      @media (max-width: 600px) {
        .nav-social {
          gap: 14px;
        }
      }

      .nav-social-link {
        display: block;
        color: var(--accent);
        text-decoration: none;
        opacity: 0.85;
        transition: opacity 0.2s ease;
      }

      .nav-social-link:hover {
        opacity: 1;
      }

      .footer {
        padding: 32px 48px;
        border-top: 2px dashed var(--border-dashed);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--muted);
      }

      @media (max-width: 900px) {
        .footer {
          padding: 24px 32px;
        }
      }

      @media (max-width: 600px) {
        .footer {
          padding: 20px 20px;
        }
      }
    </style>
  </body>
</html>
